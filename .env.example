# Required production secrets. Replace every value before docker compose up.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
CHAT_ASSISTANT_TOKEN=replace-with-a-32-byte-random-token
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
GRAFANA_PASSWORD=replace-with-a-long-random-password
INTERNAL_SERVICE_TOKEN=replace-with-a-32-byte-random-token
JAVA_BACKEND_URL=http://agent-server:18080
CHAT_RATE_LIMIT_PER_MINUTE=12

# Optional external regulation MCP. Keep disabled until a trusted provider is configured.
REGULATION_MCP_ENABLED=false
REGULATION_MCP_URL=
REGULATION_MCP_API_KEY=
REGULATION_MCP_TOOL_NAME=search_regulations
REGULATION_MCP_TIMEOUT_SECONDS=12
REGULATION_MCP_MAX_CALLS_PER_RUN=2
REGULATION_MCP_MAX_RESULTS=5
REGULATION_MCP_CACHE_SECONDS=21600
REGULATION_MCP_ALLOWED_DOMAINS=gov.cn,court.gov.cn,samr.gov.cn

# Comma-separated browser origins allowed to send credentialed API requests.
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Optional host bindings.
NGINX_PORT=80
SERVER_PORT=18080
