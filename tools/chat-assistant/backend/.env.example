# ====== LLM 对话模型（DeepSeek） ======
LLM_API_KEY=your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
PROJECT_ANALYSIS_TIMEOUT_SECONDS=90

# ====== Embedding 模型（可选，单独配置） ======
# DeepSeek 不提供 embedding API，需要使用 OpenAI 兼容 embedding 提供商
# 未配置时自动降级为 ES 关键词检索
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_DIM=2560

# ====== Elasticsearch ======
ES_HOST=http://localhost:9200
ES_INDEX=agent_contents
KB_INDEX=kb_chunks

# ====== MySQL（知识库元数据和切片事实源） ======
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=atlasmind_agent

# ====== Chat 参数 ======
CHAT_MAX_TOKENS=2048
CHAT_TEMPERATURE=0.7
RETRIEVAL_TOP_K=5

# ====== OCR（扫描版 PDF，可选） ======
# 简化版方案 C：本地 PaddleOCR 为主，云 OCR 仅预留配置。
PDF_PARSE_PROVIDER=auto
OCR_ENABLED=false
OCR_PROVIDER=paddle
OCR_LANG=ch
OCR_RENDER_DPI=180
OCR_MIN_TEXT_CHARS=30
# 0 表示不限制；生产环境建议设置配额，避免超大扫描 PDF 长时间占用资源
OCR_MAX_PAGES=0
CLOUD_OCR_BASE_URL=
CLOUD_OCR_API_KEY=
MINERU_ENABLED=false
MINERU_COMMAND=magic-pdf -p {input} -o {output}
MINERU_OUTPUT_DIR=.mineru-output

# Internal service auth
CHAT_ASSISTANT_TOKEN=atlasmind-internal-dev-token
